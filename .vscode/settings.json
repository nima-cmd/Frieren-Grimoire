{
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.extraPaths": ["."],
  "python.terminal.activateEnvironment": false,
  "editor.rulers": [88],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "files.exclude": {
    "**/__pycache__": true
  }
}
